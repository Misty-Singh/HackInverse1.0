# Copy to .env and fill in
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=3000

# Secret used to sign login tokens. Leave blank to auto-generate one (stored in server/data/.jwt_secret)
JWT_SECRET=

# First admin account, created automatically on first start. CHANGE THESE.
ADMIN_EMAIL=admin@campusprep.local
ADMIN_PASSWORD=Admin@12345
